# 존재하지 않는 주소는 모두 index.php 로 보낸다. (사이트 폴더의 .htaccess 규칙보다 이 규칙이 우선한다.)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

# lib/, controllers/ 안의 PHP 는 직접 열 수 없게 한다.
<FilesMatch "^(?!index\.php$).*\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# JSON 응답은 캐시하지 않는다.
<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
</IfModule>
